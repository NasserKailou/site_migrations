# ============================================================
# PNDM — Variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs
# NE JAMAIS committer .env dans Git !
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_URL=https://stat-niger.org/migrations
APP_TIMEZONE=Africa/Niamey

# ── Base de données MySQL 8 ───────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pndm
DB_USER=pndm_user
DB_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE_FORT

# ── Email (PHPMailer) ─────────────────────────────────────────
MAIL_HOST=smtp.ins.niger.ne
MAIL_PORT=587
MAIL_USERNAME=pndm@ins.niger.ne
MAIL_PASSWORD=MOT_DE_PASSE_SMTP
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=pndm@ins.niger.ne
MAIL_FROM_NAME="PNDM — INS Niger"
MAIL_ADMIN=admin@ins.niger.ne

# ── Sécurité ─────────────────────────────────────────────────
SESSION_NAME=PNDM_SESSION
# Clé de chiffrement pour les secrets TOTP (32 caractères hex)
ENCRYPTION_KEY=GENEREZ_UNE_CLE_ALEATOIRE_32_CHARS

# ── Chemins de stockage ───────────────────────────────────────
STORAGE_PATH=/var/www/pndm/app/storage
UPLOADS_PATH=/var/www/pndm/app/storage/uploads
LOGS_PATH=/var/www/pndm/app/storage/logs
CACHE_PATH=/var/www/pndm/app/storage/cache

# ── Analytique (optionnel) ────────────────────────────────────
GOOGLE_ANALYTICS_ID=

# ── Power BI (URL du rapport Agadez — éditable depuis l'admin) ─
POWERBI_AGADEZ_URL=
