{
    "name": "ins-niger/pndm",
    "description": "Plateforme Nationale des Données sur la Migration — Institut National de la Statistique du Niger",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "INS Niger",
            "email": "pndm@ins.niger.ne",
            "homepage": "https://stat-niger.org"
        }
    ],
    "require": {
        "php": ">=8.1",
        "endroid/qr-code": "^5.0",
        "phpmailer/phpmailer": "^7.1"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Core/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "lint": "phpcs --standard=PSR12 app/"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
