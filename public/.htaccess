RewriteEngine On

# ── Base XAMPP sous-dossier ────────────────────────────────────
# Adapter ce RewriteBase selon votre installation :
#   - Installation XAMPP sous-dossier : /site_migrations/public
#   - Installation à la racine        : /
# Ce RewriteBase sert uniquement à Apache pour résoudre les chemins
# Le strip du base path dans le routeur PHP est géré par Request::uri()
RewriteBase /site_migrations/public

# ── Sécurité : bloquer accès aux dossiers sensibles ────────────
RewriteRule ^(app|database|config|docs|vendor)/.*$ - [F,L]
RewriteCond %{SCRIPT_FILENAME} -d [OR]
RewriteCond %{SCRIPT_FILENAME} -f
RewriteRule "(^|/)\.+" - [F]

# ── En-têtes de sécurité ───────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://unpkg.com https://app.powerbi.com https://msit.powerbi.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https: blob:; frame-src https://app.powerbi.com https://msit.powerbi.com https://*.powerbi.com; connect-src 'self' https:; object-src 'none'; base-uri 'self'"
</IfModule>

# ── Compression ────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Cache statique ─────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

# ── Routing PHP — toutes les requêtes → index.php ──────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]
